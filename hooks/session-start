#!/usr/bin/env bash
# Claude Code / Antigravity SessionStart hook for APEX.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
PLUGIN_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"
using_apex_content=$(cat "${PLUGIN_ROOT}/skills/using-apex/SKILL.md" 2>&1 || echo "Error reading using-apex skill")

escape_for_json() {
    local s="$1"
    s="${s//\\/\\\\}"
    s="${s//\"/\\\"}"
    s="${s//$'\n'/\\n}"
    s="${s//$'\r'/\\r}"
    s="${s//$'\t'/\\t}"
    printf '%s' "$s"
}

using_apex_escaped=$(escape_for_json "$using_apex_content")
session_context="<EXTREMELY_IMPORTANT>\nAPEX governs this skill collection.\n\n**Below is the full content of the 'using-apex' entry skill. It is already loaded. Use the Skill tool for applicable leaf skills:**\n\n${using_apex_escaped}\n</EXTREMELY_IMPORTANT>"

printf '{\n  "hookSpecificOutput": {\n    "hookEventName": "SessionStart",\n    "additionalContext": "%s"\n  }\n}\n' "$session_context" | cat
